# ---------------------------------------------------------------
# Sprinto prospecting MVP — configuration (placeholders only)
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# Execution mode: simulation | dry_run | real_demo
#   simulation : fixtures + simulated LLM/Hunter/Gmail/Calendar. Nothing leaves the machine.
#   dry_run    : real website reads, real LLM, real Hunter, real calendar READS.
#                Emails and bookings are recorded but NOT sent/created.
#   real_demo  : real sends/bookings, but ONLY to DEMO_RECIPIENT_EMAIL.
APP_MODE=simulation

# Required before real sends are possible. Every email "to" and every
# calendar attendee is forced to this address and verified at the boundary.
DEMO_RECIPIENT_EMAIL=you@example.com
# Second explicit switch for real_demo. Must be "true" to send/book.
REAL_SENDS_ENABLED=false

# Database (SQLite). Checkpoints for the LangGraph reply agent live in a separate file.
DB_PATH=data/sprinto_agent.db
CHECKPOINT_DB_PATH=data/langgraph_checkpoints.db

# LLM provider: gemini | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional override, best first, comma separated. Empty = auto-rank the models your key can use
# (newest generation, pro > flash > lite, stable > preview) with automatic fallback down the list.
GEMINI_MODELS=
GEMINI_SEARCH_MODELS=
GEMINI_MAX_MODELS=10
GEMINI_TIMEOUT_SECONDS=90
# true = free tier only: skip models with no free quota (Pro), wait for daily resets (midnight Pacific)
GEMINI_FREE_TIER=true

# LLM (Anthropic). Leave blank in simulation mode.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# Server-side refusal fallback ("default" or "off")
LLM_SERVER_FALLBACK=default

# Hunter (only contact-data provider)
HUNTER_API_KEY=

# Google OAuth (Gmail + Calendar). Obtain a refresh token with:
#   python scripts/google_oauth.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=
GOOGLE_CALENDAR_ID=primary
SENDER_DISPLAY_NAME=Demo Sender

# Scheduling defaults
ORGANIZER_TIMEZONE=Asia/Kolkata
WORKING_HOURS_START=09:00
WORKING_HOURS_END=18:00
MEETING_MINUTES=30
BOOKING_HORIZON_DAYS=30
NO_REPLY_HANDOFF_HOURS=48

# Website reader
BROWSER_FALLBACK=false
FETCH_TIMEOUT_SECONDS=10
FETCH_MAX_BYTES=2000000

# Worker
WORKER_POLL_SECONDS=60
EMBEDDED_WORKER=false
